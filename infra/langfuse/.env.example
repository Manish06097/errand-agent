# Template for infra/langfuse/.env, which `make langfuse-up` generates (with openssl
# rand values) when it is missing. The real file is gitignored; never commit it.
# Every value below is a placeholder and will not work as is.

# Host port for Langfuse web (the API's LANGFUSE_HOST is http://localhost:<this>).
ERRAND_LANGFUSE_PORT=3100

# Service credentials (upstream ships CHANGEME defaults for these).
POSTGRES_PASSWORD=REPLACE_ME
SALT=REPLACE_ME
ENCRYPTION_KEY=REPLACE_ME_64_HEX_CHARS
NEXTAUTH_SECRET=REPLACE_ME
CLICKHOUSE_PASSWORD=REPLACE_ME
REDIS_AUTH=REPLACE_ME
MINIO_ROOT_PASSWORD=REPLACE_ME

# Headless init: the org, the project with its API keys, and the first user.
LANGFUSE_INIT_ORG_ID=errand
LANGFUSE_INIT_ORG_NAME=Errand
LANGFUSE_INIT_PROJECT_ID=errand-agent
LANGFUSE_INIT_PROJECT_NAME=errand-agent
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-REPLACE_ME
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-REPLACE_ME
LANGFUSE_INIT_USER_EMAIL=dev@errand.local
LANGFUSE_INIT_USER_NAME=Errand Dev
LANGFUSE_INIT_USER_PASSWORD=REPLACE_ME
